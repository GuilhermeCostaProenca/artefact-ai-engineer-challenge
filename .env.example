# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# EMPORIO_MODEL=claude-opus-5-5
# EMPORIO_EFFORT=medium            # low | medium | high
# EMPORIO_DATA_DIR=data
# EMPORIO_RUNTIME_DIR=runtime      # where escalations and saved transcripts go
# Freeze the agent's clock (ISO 8601, store time zone) for reproducible demos:
# EMPORIO_NOW=2026-11-03T14:30:00
